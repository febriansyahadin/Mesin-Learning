  ax_img.axis(\"off\")\n","\n","    # --- Tampilkan histogram ---\n","    ax_hist = fig.add_subplot(3, 2, position + 1)\n","    ax_hist.hist(img_rgb[:, :, 0].ravel(), bins=256, alpha=0.6, label='R')\n","    ax_hist.hist(img_rgb[:, :, 1].ravel(), bins=256, alpha=0.6, label='G')\n","    ax_hist.hist(img_rgb[:, :, 2].ravel(), bins=256, alpha=0.6, label='B')\n","    ax_hist.set_title(f\"Histogram {title}\")\n","    ax_hist.legend()\n","\n","    return klasifikasi\n","\n","# ================================\n","# 4. Gambar tomat baru (untuk diklasifikasi)\n","# ================================\n","new_tomato_path = \"/content/new_tomato.jpg\"   # ➜ masukkan gambar tomat baru di sini\n","\n","# ================================\n","# 5. Plot semua (lama + baru + histogram)\n","# ================================\n","fig = plt.figure(figsize=(12, 15))\n","\n","# Data lama (gambar + histogram)\n","process_single_tomato(img_paths[\"image1\"], \"Tomat 1 (Data Lama)\", fig, 1)\n","process_single_tomato(img_paths[\"image2\"], \"Tomat 2 (Data Lama)\", fig, 3)\n","process_single_tomato(img_paths[\"image3\"], \"Tomat 3 (Data Lama)\", fig, 5)\n","\n","# Tomat baru (gambar + histogram)\n","print(\"\\n=== HASIL KLASIFIKASI TOMAT BARU ===\")\n","hasil = process_single_tomato(new_tomato_path, \"Tomat Baru\", fig, 1)\n","plt.tight_layout()\n","plt.show()\n","\n","print(\"Klasifikasi:\", hasil)\n"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":1000},"id":"mkDh3R9HtD3B","executionInfo":{"status":"error","timestamp":1763466703726,"user_tz":-420,"elapsed":5999,"user":{"displayName":"febriansyah adi n","userId":"10867581229344160713"}},"outputId":"e560ddad-379a-4477-c534-da2245d19a24"},"execution_count":16,"outputs":[{"output_type":"stream","name":"stdout","text":["\n","=== HASIL KLASIFIKASI TOMAT BARU ===\n"]},{"output_type":"error","ename":"error","evalue":"OpenCV(4.12.0) /io/opencv/modules/imgproc/src/color.cpp:199: error: (-215:Assertion failed) !_src.empty() in functi