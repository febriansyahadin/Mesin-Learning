 a: {a1:.2f}\")\n","print(f\"Nilai b: {b1:.2f}\")\n"],"metadata":{"id":"t5j2cR9QIR5y","executionInfo":{"status":"ok","timestamp":1742836524019,"user_tz":-420,"elapsed":38,"user":{"displayName":"","userId":""}},"outputId":"d4f80490-6354-4953-f273-a38021135fd2","colab":{"base_uri":"https://localhost:8080/"}},"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["Nilai a: 0.16\n","Nilai b: 0.19\n"]}]},{"cell_type":"code","source":["import numpy as np\n","\n","# Data X dan Y\n","X1 = np.array([10, 20, 30, 40, 50])\n","Y1 = np.array([2.1, 3.8, 5.7, 7.6, 9.5])\n","\n","# Menghitung jumlah data\n","n1 = len(X1)\n","\n","# Menghitung parameter regresi\n","sum_X1Y1 = np.sum(X1 * Y1)\n","sum_X1 = np.sum(X1)\n","sum_Y1 = np.sum(Y1)\n","sum_X1_square = np.sum(X1 ** 2)\n","\n","# Menghitung nilai b dan a\n","b1 = (n1 * sum_X1Y1 - sum_X1 * sum_Y1) / (n1 * sum_X1_square - sum_X1**2)\n","a1 = (sum_Y1 - b1 * sum_X1) / n1\n","\n","# Menampilkan persamaan regresi\n","print(f\"Persamaan regresi: Y = {a1:.2f} + {b1:.2f}X\")\n"],"metadata":{"id":"jX0CuTGyRNf8","executionInfo":{"status":"ok","timestamp":1742838489297,"user_tz":-420,"elapsed":23,"user":{"displayName":"","userId":""}},"outputId":"4c70c4ad-9f59-40a3-af30-75a7d0f35629","colab":{"base_uri":"https://localhost:8080/"}},"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["Persamaan regresi: Y = 0.16 + 0.19X\n"]}]},{"cell_type":"code","source":["import numpy as np\n","\n","# Data X dan Y\n","X1 = np.array([10, 20, 30, 40, 50])\n","Y1 = np.array([2.1, 3.8, 5.7, 7.6, 9.5])\n","\n","\n","# Prediksi nilai Y untuk X = 60\n","X_prediksi = 60\n","Y_prediksi = a1 + b1 * X_prediksi\n","\n","# Menampilkan hasil\n","\n","print(f\"Prediksi nilai Y untuk X = {X_prediksi}: {Y_prediksi:.2f}\")\n"],"metadata":{"id":"1YHEuFRvRY4r","executionInfo":{"status":"ok","timestamp":1742838559425,"user_tz":-420,"elapsed":63,"user":{"displayName":"","userId":""}},"outputId":"0218d876-02dd-4ef6-8706-5fe537935f78","colab":{"base_uri":"https://localhost:8080/"}},"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["Prediksi nilai Y untuk X = 60: 11.32\n"]}]},{"cell_type":"code","source":["import numpy as np\n","\n","# Data X dan Y\n","X1 = np.array([10, 20, 30, 40, 50])\n","Y1 = np.array([2.1, 3.8, 5.7, 7.6, 9.5])\n","\n","# Menghitung jumlah data\n","n1 = len(X1)\n","\n","# Menghitung parameter regresi\n","sum_X1Y1 = np.sum(X1 * Y1)\n","sum_X1 = np.sum(X1)\n","sum_Y1 = np.sum(Y1)\n","sum_X1_square = np.sum(X1 ** 2)\n","\n","# Menghitung nilai b dan a\n","b1 = (n1 * sum_X1Y1 - sum_X1 * sum_Y1) / (n1 * sum_X1_square - sum_X1**2)\n","a1 = (sum_Y1 - b1 * sum_X1) / n1\n","\n","# Menampilkan persamaan regresi\n","print(f\"Persamaan regresi: Y = {a1:.2f} + {b1:.2f}X\")\n"],"metadata":{"id":"jwx5oPrXRtJ0","executionInfo":{"status":"ok","timestamp":1742839924724,"user_tz":-420,"elapsed":52,"user":{"displayName":"","userId":""}},"outputId":"c2e8cc61-6341-49bd-e673-ab8e524eefdf","colab":{"base_uri":"https://localhost:8080/"}},"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["Persamaan regresi: Y = 0.16 + 0.19X\n"]}]},{"cell_type":"code","source":["import numpy as np\n","import matplotlib.pyplot as plt\n","\n","# Soal 1: Regresi Linear antara Jumlah Data dan Waktu Eksekusi\n","X1 = np.array([10, 20, 30, 40, 50])\n","Y1 = np.array([2.1, 3.8, 5.7, 7.6, 9.5])\n","n1 = len(X1)\n","\n","sum_X1Y1 = np.sum(X1 * Y1)\n","sum_X1 = np.sum(X1)\n","sum_Y1 = np.sum(Y1)\n","sum_X1_square = np.sum(X1 ** 2)\n","\n","b1 = (n1 * sum_X1Y1 - sum_X1 * sum_Y1) / (n1 * sum_X1_square - sum_X1**2)\n","a1 = (sum_Y1 - b1 * sum_X1) / n1\n","\n","\n","print(f\"Persamaan regresi: Y = {a1:.2f} + {b1:.2f}X\")\n","\n","# Prediksi jika jumlah data adalah 60\n","prediksi_Y1 = a1 + b1 * 60\n","print(f\"Prediksi waktu eksekusi jika jumlah data adalah 60: {prediksi_Y1:.2f} ms\")\n","\n","# Soal 2: Regresi Linear antara Percobaan Login Gagal dan Kemungkinan Serangan\n","X2 = np.array([5, 10, 15, 20, 25])\n","Y2 = np.array([10, 25, 40, 55, 70])\n","n2 = len(X2)\n","\n","sum_X2Y2 = np.sum(X2 * Y2)\n","sum_X2 = np.sum(X2)\n","sum_Y2 = np.sum(Y2)\n","sum_X2_square = np.sum(X2 ** 2)\n","\n","b2 = (n2 * sum_X2Y2 - sum_X2 * sum_Y2) / (n2 * sum_X2_square - sum_X2**2)\n","a2 = (sum_Y2 - b2 * sum_X2) / n2\n","\n","print(f\"Persamaan regresi: Y = {a2:.2f} + {b2:.2f}X\")\n","\n","# Prediksi kemungkinan serangan jika ada 30 percobaan login gagal\n","prediksi_Y2 = a2 + b2 * 30\n","print(f\"Prediksi kemungkinan serangan jika ada 30 percobaan login gagal: {prediksi_Y2:.2f}%\")\n","\n","# Visualisasi hasil regresi linear untuk soal 2\n","plt.scatter(X2, Y2, color='green', label='Data Aktual')\n","plt.plot(X2, a2 + b2 * X2, color='orange', label='Regresi Linear')\n","plt.title(\"Regresi Linear - Percobaan Login Gagal vs Kemungkinan Serangan\")\n","plt.xlabel(\"Percobaan Login Gagal\")\n","plt.ylabel(\"Kemungkinan Serangan (%)\")\n","plt.legend()\n","plt.show()\n"],"metadata":{"id":"27MSA6B4g9XQ","executionInfo":{"status":"ok","timestamp":1742842827269,"user_tz":-420,"elapsed":320,"user":{"displayName":"","userId":""}},"outputId":"ff503126-660e-4fc0-b071-603a161b3b92","colab":{"base_uri":"https://localhost:8080/","height":541}},"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["Persamaan regresi: Y = 0.16 + 0.19X\n","Prediksi waktu eksekusi jika jumlah data adalah 60: 11.32 ms\n","Persamaan regresi: Y = -5.00 + 3.00X\n","Prediksi kemungkinan serangan jika ada 30 percobaan login gagal: 85.00%\n"]},{"output_type":"display_data","data":{"text/plain":["<Figure size 640x480 with 1 Axes>"],"image/png":"\n"},"metadata":{}}]}],"metadata":{"colab":{"toc_visible":true,"provenance":[{"file_id":"/v2/external/notebooks/intro.ipynb","timestamp":1742843003291}]},"kernelspec":{"display_name":"Python 3","name":"python3"}},"nbformat":4,"nbformat_minor":0}